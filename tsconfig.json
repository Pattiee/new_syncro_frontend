{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,                          // 🛠️ ADJUSTED: Allowed to let your type-safe craco.config.js/postcss.config.js run JSDoc passes
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,                           // 🔴 STRICT: Turn on all strict type-checking options
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",               // 🛠️ ADDED: Prevents deep package mapping errors for React 19 / TanStack v5
    "types": ["node", "jest"],                // 🛠️ UPDATED: Added jest to verify your test suites automatically
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,                           // Let CRACO / Webpack handle production output bundles
    "jsx": "react-jsx",
    "noImplicitAny": true,                    // 🔴 STRICT: Error on expressions and declarations with an implied 'any' type
    "strictNullChecks": true,                 // 🔴 STRICT: Null and undefined variables are handled with absolute strictness
    "noUnusedLocals": true,                   // Flag errors on unused local variables
    "noUnusedParameters": true                // Flag errors on unused function parameters
  },
  "include": ["src"]
}