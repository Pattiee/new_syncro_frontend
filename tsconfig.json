{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,                         // 🔴 STRICT: Do not allow JavaScript files to be compiled
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,                           // 🔴 STRICT: Turn on all strict type-checking options
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,                           // Let CRACO / Webpack handle production output bundles
    "jsx": "react-jsx",
    "noImplicitAny": true,                    // 🔴 STRICT: Error on expressions and declarations with an implied 'any' type
    "strictNullChecks": true,                 // 🔴 STRICT: Null and undefined variables are handled with absolute strictness
    "noUnusedLocals": true,                   // Flag errors on unused local variables
    "noUnusedParameters": true                // Flag errors on unused function parameters
  },
  "include": ["src"]
}